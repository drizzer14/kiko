# Committed, PUBLIC (non-secret) configuration consumed via `@env`
# (react-native-dotenv). Keeping this file tracked means Jest and CI build
# the same values with no mock. For local-only overrides, copy a key into an
# untracked `.env.local` (gitignored) instead of editing this file.

# CoinGecko public simple-price endpoint for the BTC->USD quote.
PRICE_ENDPOINT=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd

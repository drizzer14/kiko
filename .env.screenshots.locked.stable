# DEV/TEST-ONLY environment file for the LOCK-SCREEN STABLE-GLASS regression
# build. A copy of `.env.screenshots.stable` (same public values, SCREENSHOT_MODE
# + SCREENSHOT_LANG + SCREENSHOT_STABLE_GLASS) PLUS SCREENSHOT_SCENARIO=locked, so
# the seed builds the SAME rich dataset but enables the app lock and the
# cold-launch LockGate shows the lock screen. Selected by building with
# `ENVFILE=.env.screenshots.locked.stable` (see babel.config.js). Use this build
# ONLY for the pixelmatch visual-regression check of the lock screen. Carries
# ONLY public, non-secret values — react-native-dotenv inlines every value into
# the JS bundle at build time, exactly like `.env`, so the same rule applies:
# never put a token, key, or credential here. Secrets live in the iOS Keychain.

# --- Same public endpoints as `.env` (copied verbatim) ---

# Monobank personal API base URL (client-info and statement requests).
MONOBANK_API_ENDPOINT=https://api.monobank.ua

# CoinGecko public simple-price endpoint for the BTC->USD quote.
PRICE_ENDPOINT=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd

# Esplora-compatible block explorer (Blockstream) for a BTC address's on-chain balance.
BTC_EXPLORER_ENDPOINT=https://blockstream.info/api

# Binance spot REST base URL (signed, read-only account requests).
BINANCE_API_ENDPOINT=https://api.binance.com

# Binance API-key management page, linked from the credentials field.
BINANCE_API_MANAGEMENT_URL=https://app.binance.com/en/my/settings/api-management

# --- Screenshot-mode switches (absent from `.env`, so production is unchanged) ---

# Turns on screenshot mode: the app seeds a deterministic demo dataset at boot
# and forces reduced motion. Read by src/screenshot/screenshot-mode.ts.
SCREENSHOT_MODE=true

# The language the deterministic seed applies. 'uk' is the App Store deliverable;
# switch to 'en' for the English set. Defaults to 'en' when unset/unsupported.
SCREENSHOT_LANG=uk

# --- Stable-glass switch (absent from `.env` AND `.env.screenshots`) ---

# Swaps every GlassSurface for a fixed OPAQUE surface (no live LiquidGlass
# sampling, no bloom) so the pixelmatch regression check gets byte-stable
# pixels. Read by src/screenshot/screenshot-mode.ts (isStableGlass).
SCREENSHOT_STABLE_GLASS=true

# --- Scenario switch (absent from every other env file) ---

# Selects the LOCKED dataset: the seed builds the SAME rich dataset but enables
# the app lock, so the cold-launch LockGate shows the lock screen. Under
# screenshot mode LockGate does NOT auto-invoke biometrics on mount (so the sim
# never hits the system dialog). Read by src/screenshot/screenshot-mode.ts
# (screenshotScenario) and src/screenshot/seed/screenshot-seed.ts. Defaults to
# 'rich' when unset/unknown.
SCREENSHOT_SCENARIO=locked

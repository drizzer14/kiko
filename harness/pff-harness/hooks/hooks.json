{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/scripts/checks/fast.sh", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/scripts/checks/medium.sh", "timeout": 300 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/scripts/checks/medium.sh", "timeout": 300 }
        ]
      }
    ]
  }
}

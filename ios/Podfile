# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, "18.2"

# Build React Native core from source instead of the prebuilt React.xcframework.
# The prebuilt facade exposes core headers only as <React/...>, but
# react-native-bottom-tabs (RCTTabViewComponentView.mm) imports "RCTConversions.h"
# with quotes, which only resolves against the from-source header search paths.
# Must be set before use_react_native! reads it.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Kiko' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Floor every pod's iOS deployment target to the app's own
    # IPHONEOS_DEPLOYMENT_TARGET (18.2). Xcode 27 requires pods at iOS
    # 15.0 or higher, and a pod above the app min could reference symbols
    # missing on iOS 18.2-18.x. Raise only pods below the floor.
    app_ios_deployment_target = Gem::Version.new('18.2')
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |pod_config|
        current = pod_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && Gem::Version.new(current) < app_ios_deployment_target
          pod_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = app_ios_deployment_target.to_s
        end
      end
    end
  end
end

+// UIKit insets a large title by the navigation bar's layout margin, which it derives from the
+// stack's distance to the window's edge (20 pt at the window's leading edge, 0 elsewhere), so a
+// stack that is one pane of a split window would not line up with its content. With a fixed
+// margin the view stops respecting the system minimum and both the view and the bar take that
+// margin on the leading and trailing edges, whatever the stack's position. Nothing here runs
+// while `fixedContentMargin` is 0.
+- (void)setFixedContentMargin:(CGFloat)fixedContentMargin
+{
+  if (_fixedContentMargin == fixedContentMargin) {
+    return;
+  }
+
+  BOOL wasFixed = _fixedContentMargin > 0;
+  _fixedContentMargin = fixedContentMargin;
+
+  if (fixedContentMargin > 0) {
+    if (!wasFixed) {
+      _viewMarginsBeforeFixedContentMargin = self.view.directionalLayoutMargins;
+      _barMarginsBeforeFixedContentMargin = self.navigationBar.directionalLayoutMargins;
+    }
+    [self applyFixedContentMargin];
+  } else if (wasFixed) {
+    self.viewRespectsSystemMinimumLayoutMargins = YES;
+    self.view.directionalLayoutMargins = _viewMarginsBeforeFixedContentMargin;
+    self.navigationBar.directionalLayoutMargins = _barMarginsBeforeFixedContentMargin;
+  }
+}
+
+- (void)applyFixedContentMargin
+{
+  if (_fixedContentMargin <= 0) {
+    return;
+  }
+
+  self.viewRespectsSystemMinimumLayoutMargins = NO;
+
+  NSDirectionalEdgeInsets viewMargins = self.view.directionalLayoutMargins;
+  viewMargins.leading = _fixedContentMargin;
+  viewMargins.trailing = _fixedContentMargin;
+  self.view.directionalLayoutMargins = viewMargins;
+
+  // UIKit lays the bar out and sets its margins on its own, so they are set again after each layout.
+  NSDirectionalEdgeInsets barMargins = self.navigationBar.directionalLayoutMargins;
+  barMargins.leading = _fixedContentMargin;
+  barMargins.trailing = _fixedContentMargin;
+  self.navigationBar.directionalLayoutMargins = barMargins;
+}
 

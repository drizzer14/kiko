# Example environment file documenting every key read through `@env`
# (react-native-dotenv). Copy this file to `.env` after cloning; the app and
# Jest read `.env` at build time. `.env` is NOT committed (it is gitignored).
# All values are public, non-secret config. For a per-machine override, copy a
# key into an untracked `.env.local`.

# Monobank personal API base URL (client-info and statement requests).
MONOBANK_API_ENDPOINT=https://api.monobank.ua

# CoinGecko public simple-price endpoint for the BTC->USD quote.
PRICE_ENDPOINT=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd

# Esplora-compatible block explorer (Blockstream) for a BTC address's on-chain balance.
BTC_EXPLORER_ENDPOINT=https://blockstream.info/api

# Binance spot REST base URL (signed, read-only account requests).
BINANCE_API_ENDPOINT=https://api.binance.com

# Binance API-key management page, linked from the credentials field.
BINANCE_API_MANAGEMENT_URL=https://app.binance.com/en/my/settings/api-management

# Example environment file documenting every key read through `@env`
# (react-native-dotenv). The `postinstall` step (scripts/ensure-env.js) copies
# this file to `.env` automatically when `.env` is missing, so a fresh checkout
# has a working `.env` with no manual step. A manual copy still works, and it is
# never overwritten (so a hand-edited `.env` survives `npm install`). The app
# and Jest read `.env` at build time. `.env` is NOT committed (it is
# gitignored). All values are public, non-secret config. For a per-machine
# override, copy a key into an untracked `.env.local`.

# Monobank personal API base URL (client-info and statement requests).
MONOBANK_API_ENDPOINT=https://api.monobank.ua

# PrivatBank Privat24 AutoClient API base URL (accounts and statement
# requests). Public, non-secret base URL — same class as MONOBANK_API_ENDPOINT
# above. TODO(VERIFY LIVE): confirm the exact AutoClient base URL against
# Privat24's own "API for developers" documentation; this is a best-effort
# placeholder (see docs/plans/bank-providers.md section B).
PRIVATBANK_API_ENDPOINT=https://acp.privatbank.ua

# bunq public API base URL (handshake + monetary-account/payment reads).
# CONFIRMED (coordinator's live verification pass against bunq's own docs):
# sandbox is https://public-api.sandbox.bunq.com/v1, production is
# https://api.bunq.com/v1. Defaults to the sandbox base — a sandbox API key
# is created via POST /v1/sandbox-user-person (bunq's own test-user endpoint);
# a production key comes from the bunq app (Profile > Security & Privacy >
# Developers > API keys). Switch this value to the production base once a
# real device connection is wired (see src/bunq/crypto/bunq-crypto.ts).
BUNQ_API_ENDPOINT=https://public-api.sandbox.bunq.com/v1

# Starling Bank v2 public API base URL (accounts, balance, and feed reads).
# COORDINATOR-VERIFIED against Starling's own developer docs: sandbox is
# https://api-sandbox.starlingbank.com, production is
# https://api.starlingbank.com. Defaults to the sandbox base — a Personal
# Access Token is created in the Starling developer portal with account,
# balance, and transaction read access. Switch this value to the production
# base once a real device connection is wired.
STARLING_API_ENDPOINT=https://api-sandbox.starlingbank.com

# CoinGecko public simple-price endpoint for the BTC->USD quote.
PRICE_ENDPOINT=https://api.coingecko.com/api/v3/simple/price

# Esplora-compatible block explorer (Blockstream) for a BTC address's on-chain balance.
BTC_EXPLORER_ENDPOINT=https://blockstream.info/api

# Binance spot REST base URL (signed, read-only account requests).
BINANCE_API_ENDPOINT=https://api.binance.com

# Binance API-key management page, linked from the credentials field.
BINANCE_API_MANAGEMENT_URL=https://app.binance.com/en/my/settings/api-management
